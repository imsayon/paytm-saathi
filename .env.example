# Paytm Saathi local configuration.
# Copy to .env.local for Next.js, or .env for scripts/worker. Never commit real secrets.

# SQLite database file for the demo. Relative paths resolve from the repository root.
SAATHI_DB_PATH=./data/saathi.db

# Demo mode exposes the /api/campaigns/{id}/demo/* controls and the seeded merchant session.
# Must be explicitly "false" in any deployment that is not a local demo.
SAATHI_DEMO_MODE=true

# Optional. When absent, the planner uses the deterministic template fallback and labels it in the audit trail.
OPENAI_API_KEY=

# Optional planner model override.
SAATHI_OPENAI_MODEL=gpt-4o-mini
