# Paytm Saathi local configuration.
# Copy to .env (scripts, worker, tests and Next.js all read it). Never commit real values.

# Neon Postgres. Paste the strings from the Neon console for project "paytm-saathi".
# Pooled endpoint (host contains "-pooler"): normal application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/paytm_saathi?sslmode=verify-full
# Direct endpoint (same host without "-pooler"): migrations and schema administration.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/paytm_saathi?sslmode=verify-full

# Test database for `pnpm test` and `pnpm test:e2e`. Tests create and drop their
# own schemas; the e2e run resets the demo merchant's data. Point this at the Neon
# "test" branch (direct endpoint) or a local Postgres, never at the production branch.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/paytm_saathi?sslmode=verify-full
# TEST_DATABASE_URL=postgresql://localhost:5432/saathi_test

# Demo mode exposes /api/demo/* and the seeded merchant session for local previews.
# Keep this false for deployments where every merchant signs in.
SAATHI_DEMO_MODE=false

# Neon Auth. Enable it on the target Neon branch, then copy the branch Auth URL
# from Neon Console. Keep the cookie secret private and use a different value
# per deployment; it signs the app-local session cache cookie.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/DATABASE/auth
NEON_AUTH_COOKIE_SECRET=

# Optional shared secret for Paytm-facing canonical REST/webhook ingestion.
# Requests sign `timestamp + "." + raw_body` with HMAC-SHA256 and send
# x-saathi-timestamp plus x-saathi-signature: sha256=<hex>.
SAATHI_CONNECTOR_API_KEY=

# Optional. When absent, the planner uses the deterministic template fallback and labels it in the audit trail.
GEMINI_API_KEY=

# Optional planner model override.
SAATHI_GEMINI_MODEL=gemini-2.5-flash

# Delivery provider. "mock" (default) never contacts anyone. "twilio" sends real
# SMS or WhatsApp messages to routable contact references (+E164, sms:+E164,
# whatsapp:+E164); the synthetic fixture is refused. Never commit real values.
SAATHI_DELIVERY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sender: your Twilio number (+E164) for SMS, or the WhatsApp sandbox/business sender (whatsapp:+E164).
TWILIO_FROM=
# Optional: how long a send waits for Twilio's terminal status before the worker treats it as a timeout.
TWILIO_SEND_WAIT_MS=8000
# Optional: public origin of this deployment. Enables Twilio status callbacks to /api/providers/twilio/status.
PUBLIC_BASE_URL=
# Optional: `pnpm delivery:check` sends one test message here (a number verified on your Twilio account).
TWILIO_TEST_TO=

# Optional signed event delivery to n8n. Events contain aggregate facts only;
# the approval gate and provider call stay inside Saathi.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional Cognee Cloud/self-hosted memory mirror. Neon remains the source of truth.
# Cognee Cloud shows a per-tenant URL on its API Keys page; use that URL here.
COGNEE_BASE_URL=https://YOUR_TENANT.aws.cognee.ai
COGNEE_API_KEY=
